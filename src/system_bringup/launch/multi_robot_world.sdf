<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="default">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ========== TURTLEBOT3 (İKA) ========== -->
    <model name="turtlebot3">
      <pose>-1 0 0.035 0 0 0</pose>
      <link name="base_link">
        <inertial><mass>1.0</mass>
          <inertia><ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz></inertia>
        </inertial>
        <visual name="body"><geometry><box><size>0.14 0.14 0.07</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
        <collision name="body"><geometry><box><size>0.14 0.14 0.07</size></box></geometry></collision>
        <collision name="caster">
          <pose>-0.05 0 -0.023 0 0 0</pose>
          <geometry><sphere><radius>0.012</radius></sphere></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2><slip1>1</slip1><slip2>1</slip2></ode></friction></surface>
        </collision>
      </link>
      <link name="lidar"><pose relative_to="base_link">-0.02 0 0.055 0 0 0</pose>
        <inertial><mass>0.05</mass><inertia><ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz></inertia></inertial>
        <visual name="v"><geometry><cylinder><radius>0.035</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0 0 0.8 1</ambient><diffuse>0 0 0.9 1</diffuse></material></visual>
      </link>
      <joint name="lidar_joint" type="fixed"><parent>base_link</parent><child>lidar</child></joint>
      <link name="wl"><pose relative_to="base_link">0 0.08 -0.012 -1.5708 0 0</pose>
        <inertial><mass>0.05</mass><inertia><ixx>0.00005</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00005</iyy><iyz>0</iyz><izz>0.00005</izz></inertia></inertial>
        <visual name="v"><geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
        <collision name="c"><geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision>
      </link>
      <link name="wr"><pose relative_to="base_link">0 -0.08 -0.012 -1.5708 0 0</pose>
        <inertial><mass>0.05</mass><inertia><ixx>0.00005</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00005</iyy><iyz>0</iyz><izz>0.00005</izz></inertia></inertial>
        <visual name="v"><geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
        <collision name="c"><geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision>
      </link>
      <joint name="wl_joint" type="revolute"><parent>base_link</parent><child>wl</child><axis><xyz>0 0 1</xyz></axis></joint>
      <joint name="wr_joint" type="revolute"><parent>base_link</parent><child>wr</child><axis><xyz>0 0 1</xyz></axis></joint>
      <plugin filename="libignition-gazebo6-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
        <left_joint>wl_joint</left_joint><right_joint>wr_joint</right_joint>
        <wheel_separation>0.160</wheel_separation><wheel_radius>0.033</wheel_radius>
        <topic>ugv_cmd_vel</topic><odom_topic>ugv_odom</odom_topic><odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
    </model>

    <!-- ========== ROBOT KOL (6-DOF) ========== -->
    <model name="robot_arm">
      <pose>1 0 0 0 0 0</pose>

      <!-- Base (sabit) -->
      <link name="base_link">
        <inertial><mass>2.0</mass><inertia><ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.01</iyy><iyz>0</iyz><izz>0.01</izz></inertia></inertial>
        <visual name="v"><geometry><cylinder><radius>0.06</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <collision name="c"><geometry><cylinder><radius>0.06</radius><length>0.04</length></cylinder></geometry></collision>
      </link>

      <!-- Link 1 - Shoulder rotation -->
      <link name="link1">
        <pose relative_to="base_link">0 0 0.05 0 0 0</pose>
        <inertial><mass>0.5</mass><inertia><ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz></inertia></inertial>
        <visual name="v"><geometry><cylinder><radius>0.04</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.8 0.2 0.0 1</ambient><diffuse>0.9 0.3 0.0 1</diffuse></material></visual>
        <collision name="c"><geometry><cylinder><radius>0.04</radius><length>0.08</length></cylinder></geometry></collision>
      </link>
      <joint name="world_fix" type="fixed"><parent>world</parent><child>base_link</child></joint>
      <joint name="joint1" type="revolute">
        <parent>base_link</parent><child>link1</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-3.14</lower><upper>3.14</upper><effort>50</effort></limit></axis>
      </joint>

      <!-- Link 2 - Shoulder lift -->
      <link name="link2">
        <pose relative_to="link1">0 0 0.12 0 0 0</pose>
        <inertial><mass>0.4</mass><inertia><ixx>0.002</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.002</iyy><iyz>0</iyz><izz>0.0005</izz></inertia></inertial>
        <visual name="v"><geometry><box><size>0.03 0.03 0.2</size></box></geometry>
          <material><ambient>0.0 0.5 0.8 1</ambient><diffuse>0.0 0.6 0.9 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.03 0.03 0.2</size></box></geometry></collision>
      </link>
      <joint name="joint2" type="revolute">
        <parent>link1</parent><child>link2</child>
        <axis><xyz>0 1 0</xyz><limit><lower>-1.57</lower><upper>1.57</upper><effort>50</effort></limit></axis>
      </joint>

      <!-- Link 3 - Elbow -->
      <link name="link3">
        <pose relative_to="link2">0 0 0.18 0 0 0</pose>
        <inertial><mass>0.3</mass><inertia><ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.001</iyy><iyz>0</iyz><izz>0.0003</izz></inertia></inertial>
        <visual name="v"><geometry><box><size>0.025 0.025 0.16</size></box></geometry>
          <material><ambient>0.0 0.5 0.8 1</ambient><diffuse>0.0 0.6 0.9 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.025 0.025 0.16</size></box></geometry></collision>
      </link>
      <joint name="joint3" type="revolute">
        <parent>link2</parent><child>link3</child>
        <axis><xyz>0 1 0</xyz><limit><lower>-2.0</lower><upper>2.0</upper><effort>30</effort></limit></axis>
      </joint>

      <!-- Link 4 - Wrist rotation -->
      <link name="link4">
        <pose relative_to="link3">0 0 0.12 0 0 0</pose>
        <inertial><mass>0.2</mass><inertia><ixx>0.0005</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0005</iyy><iyz>0</iyz><izz>0.0002</izz></inertia></inertial>
        <visual name="v"><geometry><cylinder><radius>0.02</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.8 0.2 0.0 1</ambient><diffuse>0.9 0.3 0.0 1</diffuse></material></visual>
        <collision name="c"><geometry><cylinder><radius>0.02</radius><length>0.06</length></cylinder></geometry></collision>
      </link>
      <joint name="joint4" type="revolute">
        <parent>link3</parent><child>link4</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-3.14</lower><upper>3.14</upper><effort>20</effort></limit></axis>
      </joint>

      <!-- Gripper base -->
      <link name="gripper_base">
        <pose relative_to="link4">0 0 0.05 0 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia></inertial>
        <visual name="v"><geometry><box><size>0.06 0.02 0.02</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.06 0.02 0.02</size></box></geometry></collision>
      </link>
      <joint name="gripper_joint" type="fixed">
        <parent>link4</parent><child>gripper_base</child>
      </joint>

      <!-- Left finger -->
      <link name="finger_left">
        <pose relative_to="gripper_base">-0.02 0 0.025 0 0 0</pose>
        <inertial><mass>0.02</mass><inertia><ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz></inertia></inertial>
        <visual name="v"><geometry><box><size>0.01 0.02 0.04</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.01 0.02 0.04</size></box></geometry></collision>
      </link>
      <joint name="finger_left_joint" type="prismatic">
        <parent>gripper_base</parent><child>finger_left</child>
        <axis><xyz>1 0 0</xyz><limit><lower>-0.02</lower><upper>0.0</upper><effort>10</effort></limit></axis>
      </joint>

      <!-- Right finger -->
      <link name="finger_right">
        <pose relative_to="gripper_base">0.02 0 0.025 0 0 0</pose>
        <inertial><mass>0.02</mass><inertia><ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz></inertia></inertial>
        <visual name="v"><geometry><box><size>0.01 0.02 0.04</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.01 0.02 0.04</size></box></geometry></collision>
      </link>
      <joint name="finger_right_joint" type="prismatic">
        <parent>gripper_base</parent><child>finger_right</child>
        <axis><xyz>1 0 0</xyz><limit><lower>0.0</lower><upper>0.02</upper><effort>10</effort></limit></axis>
      </joint>

      <!-- Joint position controller plugin -->
      <plugin filename="libignition-gazebo6-joint-position-controller-system.so" name="ignition::gazebo::systems::JointPositionController">
        <joint_name>joint1</joint_name><topic>arm_joint1_cmd</topic><p_gain>20</p_gain><i_gain>0.1</i_gain><d_gain>1.0</d_gain>
      </plugin>
      <plugin filename="libignition-gazebo6-joint-position-controller-system.so" name="ignition::gazebo::systems::JointPositionController">
        <joint_name>joint2</joint_name><topic>arm_joint2_cmd</topic><p_gain>20</p_gain><i_gain>0.1</i_gain><d_gain>1.0</d_gain>
      </plugin>
      <plugin filename="libignition-gazebo6-joint-position-controller-system.so" name="ignition::gazebo::systems::JointPositionController">
        <joint_name>joint3</joint_name><topic>arm_joint3_cmd</topic><p_gain>15</p_gain><i_gain>0.1</i_gain><d_gain>0.5</d_gain>
      </plugin>
      <plugin filename="libignition-gazebo6-joint-position-controller-system.so" name="ignition::gazebo::systems::JointPositionController">
        <joint_name>joint4</joint_name><topic>arm_joint4_cmd</topic><p_gain>10</p_gain><i_gain>0.1</i_gain><d_gain>0.5</d_gain>
      </plugin>
      <plugin filename="libignition-gazebo6-joint-state-publisher-system.so" name="ignition::gazebo::systems::JointStatePublisher">
        <topic>arm_joint_states</topic>
      </plugin>
    </model>
  </world>
</sdf>
