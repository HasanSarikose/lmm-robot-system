<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="lmm_world">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo6-sensors-system.so" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libignition-gazebo6-imu-system.so" name="ignition::gazebo::systems::Imu"/>
    <plugin filename="libignition-gazebo6-navsat-system.so" name="ignition::gazebo::systems::NavSat"/>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ========== DRONE (İHA) ========== -->
    <model name="drone">
      <static>true</static>
      <pose>0 0 0.15 0 0 0</pose>
      <link name="body">
        <visual name="center">
          <geometry><cylinder><radius>0.06</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <visual name="top_cover">
          <pose>0 0 0.025 0 0 0</pose>
          <geometry><box><size>0.08 0.08 0.015</size></box></geometry>
          <material><ambient>0.0 0.4 0.0 1</ambient><diffuse>0.0 0.5 0.0 1</diffuse></material>
        </visual>
        <visual name="gps">
          <pose>0 0 0.045 0 0 0</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
        <visual name="battery">
          <pose>0 0 -0.03 0 0 0</pose>
          <geometry><box><size>0.06 0.03 0.02</size></box></geometry>
          <material><ambient>0.1 0.1 0.4 1</ambient><diffuse>0.1 0.1 0.5 1</diffuse></material>
        </visual>

        <visual name="arm_fr"><pose>0.1 -0.1 0 0 0 -0.785</pose>
          <geometry><box><size>0.22 0.018 0.012</size></box></geometry>
          <material><ambient>0.6 0.0 0.0 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual>
        <visual name="arm_fl"><pose>0.1 0.1 0 0 0 0.785</pose>
          <geometry><box><size>0.22 0.018 0.012</size></box></geometry>
          <material><ambient>0.6 0.0 0.0 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual>
        <visual name="arm_rl"><pose>-0.1 0.1 0 0 0 -0.785</pose>
          <geometry><box><size>0.22 0.018 0.012</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
        <visual name="arm_rr"><pose>-0.1 -0.1 0 0 0 0.785</pose>
          <geometry><box><size>0.22 0.018 0.012</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>

        <visual name="motor_fr"><pose>0.18 -0.18 0.01 0 0 0</pose>
          <geometry><cylinder><radius>0.018</radius><length>0.025</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
        <visual name="motor_fl"><pose>0.18 0.18 0.01 0 0 0</pose>
          <geometry><cylinder><radius>0.018</radius><length>0.025</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
        <visual name="motor_rl"><pose>-0.18 0.18 0.01 0 0 0</pose>
          <geometry><cylinder><radius>0.018</radius><length>0.025</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
        <visual name="motor_rr"><pose>-0.18 -0.18 0.01 0 0 0</pose>
          <geometry><cylinder><radius>0.018</radius><length>0.025</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>

        <visual name="prop_fr"><pose>0.18 -0.18 0.025 0 0 0</pose>
          <geometry><cylinder><radius>0.07</radius><length>0.003</length></cylinder></geometry>
          <material><ambient>0.3 0.0 0.0 0.7</ambient><diffuse>0.5 0.1 0.1 0.7</diffuse></material></visual>
        <visual name="prop_fl"><pose>0.18 0.18 0.025 0 0 0</pose>
          <geometry><cylinder><radius>0.07</radius><length>0.003</length></cylinder></geometry>
          <material><ambient>0.3 0.0 0.0 0.7</ambient><diffuse>0.5 0.1 0.1 0.7</diffuse></material></visual>
        <visual name="prop_rl"><pose>-0.18 0.18 0.025 0 0 0</pose>
          <geometry><cylinder><radius>0.07</radius><length>0.003</length></cylinder></geometry>
          <material><ambient>0.0 0.0 0.3 0.7</ambient><diffuse>0.1 0.1 0.5 0.7</diffuse></material></visual>
        <visual name="prop_rr"><pose>-0.18 -0.18 0.025 0 0 0</pose>
          <geometry><cylinder><radius>0.07</radius><length>0.003</length></cylinder></geometry>
          <material><ambient>0.0 0.0 0.3 0.7</ambient><diffuse>0.1 0.1 0.5 0.7</diffuse></material></visual>

        <visual name="leg_fr"><pose>0.08 -0.06 -0.05 0 0 0</pose>
          <geometry><box><size>0.008 0.008 0.07</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material></visual>
        <visual name="leg_fl"><pose>0.08 0.06 -0.05 0 0 0</pose>
          <geometry><box><size>0.008 0.008 0.07</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material></visual>
        <visual name="leg_rl"><pose>-0.08 0.06 -0.05 0 0 0</pose>
          <geometry><box><size>0.008 0.008 0.07</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material></visual>
        <visual name="leg_rr"><pose>-0.08 -0.06 -0.05 0 0 0</pose>
          <geometry><box><size>0.008 0.008 0.07</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material></visual>

        <visual name="skid_l"><pose>0 0.06 -0.085 0 0 0</pose>
          <geometry><box><size>0.22 0.008 0.008</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material></visual>
        <visual name="skid_r"><pose>0 -0.06 -0.085 0 0 0</pose>
          <geometry><box><size>0.22 0.008 0.008</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material></visual>

        <visual name="cam"><pose>0.04 0 -0.03 0 0.3 0</pose>
          <geometry><box><size>0.025 0.03 0.02</size></box></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <visual name="cam_lens"><pose>0.052 0 -0.025 0 0.3 0</pose>
          <geometry><cylinder><radius>0.008</radius><length>0.008</length></cylinder></geometry>
          <material><ambient>0.0 0.0 0.2 1</ambient><diffuse>0.0 0.0 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ========== İKA (4 Tekerlekli) ========== -->
    <model name="turtlebot3">
      <pose>-2 0 0.05 0 0 0</pose>
      <link name="base_link">
        <inertial><mass>2.0</mass><inertia><ixx>0.005</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.008</iyy><iyz>0</iyz><izz>0.005</izz></inertia></inertial>
        <visual name="body"><geometry><box><size>0.30 0.20 0.08</size></box></geometry><material><ambient>0.15 0.3 0.15 1</ambient><diffuse>0.2 0.4 0.2 1</diffuse></material></visual>
        <collision name="body"><geometry><box><size>0.30 0.20 0.08</size></box></geometry></collision>
        <visual name="top"><pose>-0.02 0 0.055 0 0 0</pose><geometry><box><size>0.12 0.16 0.03</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <visual name="lidar"><pose>0.05 0 0.07 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.03</length></cylinder></geometry><material><ambient>0 0 0.6 1</ambient><diffuse>0 0 0.8 1</diffuse></material></visual>
        <visual name="camera"><pose>0.14 0 0.02 0 0 0</pose><geometry><box><size>0.02 0.04 0.02</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient></material></visual>
      </link>

      <link name="wheel_fl"><pose relative_to="base_link">0.1 0.11 -0.02 -1.5708 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia></inertial>
        <visual name="v"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <collision name="c"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
      </link>
      <joint name="wfl_joint" type="revolute"><parent>base_link</parent><child>wheel_fl</child><axis><xyz>0 0 1</xyz></axis></joint>

      <link name="wheel_fr"><pose relative_to="base_link">0.1 -0.11 -0.02 -1.5708 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia></inertial>
        <visual name="v"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <collision name="c"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
      </link>
      <joint name="wfr_joint" type="revolute"><parent>base_link</parent><child>wheel_fr</child><axis><xyz>0 0 1</xyz></axis></joint>

      <link name="wheel_rl"><pose relative_to="base_link">-0.1 0.11 -0.02 -1.5708 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia></inertial>
        <visual name="v"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <collision name="c"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
      </link>
      <joint name="wrl_joint" type="revolute"><parent>base_link</parent><child>wheel_rl</child><axis><xyz>0 0 1</xyz></axis></joint>

      <link name="wheel_rr"><pose relative_to="base_link">-0.1 -0.11 -0.02 -1.5708 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia></inertial>
        <visual name="v"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <collision name="c"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
      </link>
      <joint name="wrr_joint" type="revolute"><parent>base_link</parent><child>wheel_rr</child><axis><xyz>0 0 1</xyz></axis></joint>

      <plugin filename="libignition-gazebo6-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
        <left_joint>wfl_joint</left_joint>
        <left_joint>wrl_joint</left_joint>
        <right_joint>wfr_joint</right_joint>
        <right_joint>wrr_joint</right_joint>
        <wheel_separation>0.22</wheel_separation>
        <wheel_radius>0.04</wheel_radius>
        <topic>ugv_cmd_vel</topic>
        <odom_topic>ugv_odom</odom_topic>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
      <plugin filename="libignition-gazebo6-odometry-publisher-system.so" name="ignition::gazebo::systems::OdometryPublisher">
        <odom_topic>ika/odom</odom_topic>
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
    </model>

    <!-- ========== ROBOT KOL (6-DOF + Gripper) ========== -->
    <model name="robot_arm">
      <pose>2 0 0 0 0 0</pose>
      <joint name="world_fix" type="fixed"><parent>world</parent><child>base_link</child></joint>

      <link name="base_link">
        <inertial><mass>3.0</mass><inertia><ixx>0.02</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.02</iyy><iyz>0</iyz><izz>0.02</izz></inertia></inertial>
        <visual name="base_plate"><pose>0 0 0.01 0 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <visual name="base_column"><pose>0 0 0.04 0 0 0</pose>
          <geometry><cylinder><radius>0.045</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <collision name="c"><pose>0 0 0.03 0 0 0</pose><geometry><cylinder><radius>0.08</radius><length>0.06</length></cylinder></geometry></collision>
      </link>

      <link name="link1"><pose relative_to="base_link">0 0 0.08 0 0 0</pose>
        <inertial><mass>0.6</mass><inertia><ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz></inertia></inertial>
        <visual name="v"><geometry><cylinder><radius>0.04</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.7 0.3 0.0 1</ambient><diffuse>0.9 0.4 0.0 1</diffuse></material></visual>
        <collision name="c"><geometry><cylinder><radius>0.04</radius><length>0.06</length></cylinder></geometry></collision>
      </link>
      <joint name="joint1" type="revolute"><parent>base_link</parent><child>link1</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-3.14</lower><upper>3.14</upper><effort>50</effort></limit><dynamics><damping>0.5</damping></dynamics></axis></joint>

      <link name="link2"><pose relative_to="link1">0 0 0.06 0 0 0</pose>
        <inertial><mass>0.5</mass><inertia><ixx>0.003</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.003</iyy><iyz>0</iyz><izz>0.0005</izz></inertia></inertial>
        <visual name="joint_cap"><geometry><sphere><radius>0.03</radius></sphere></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
        <visual name="upper_arm"><pose>0 0 0.1 0 0 0</pose>
          <geometry><box><size>0.035 0.035 0.2</size></box></geometry>
          <material><ambient>0.0 0.35 0.7 1</ambient><diffuse>0.0 0.45 0.85 1</diffuse></material></visual>
        <collision name="c"><pose>0 0 0.1 0 0 0</pose><geometry><box><size>0.035 0.035 0.2</size></box></geometry></collision>
      </link>
      <joint name="joint2" type="revolute"><parent>link1</parent><child>link2</child>
        <axis><xyz>0 1 0</xyz><limit><lower>-1.57</lower><upper>1.57</upper><effort>50</effort></limit><dynamics><damping>0.5</damping></dynamics></axis></joint>

      <link name="link3"><pose relative_to="link2">0 0 0.2 0 0 0</pose>
        <inertial><mass>0.4</mass><inertia><ixx>0.002</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.002</iyy><iyz>0</iyz><izz>0.0003</izz></inertia></inertial>
        <visual name="joint_cap"><geometry><sphere><radius>0.025</radius></sphere></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
        <visual name="forearm"><pose>0 0 0.08 0 0 0</pose>
          <geometry><box><size>0.03 0.03 0.16</size></box></geometry>
          <material><ambient>0.0 0.35 0.7 1</ambient><diffuse>0.0 0.45 0.85 1</diffuse></material></visual>
        <collision name="c"><pose>0 0 0.08 0 0 0</pose><geometry><box><size>0.03 0.03 0.16</size></box></geometry></collision>
      </link>
      <joint name="joint3" type="revolute"><parent>link2</parent><child>link3</child>
        <axis><xyz>0 1 0</xyz><limit><lower>-2.35</lower><upper>2.35</upper><effort>30</effort></limit><dynamics><damping>0.3</damping></dynamics></axis></joint>

      <link name="link4"><pose relative_to="link3">0 0 0.16 0 0 0</pose>
        <inertial><mass>0.25</mass><inertia><ixx>0.0005</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0005</iyy><iyz>0</iyz><izz>0.0003</izz></inertia></inertial>
        <visual name="v"><geometry><cylinder><radius>0.022</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.7 0.3 0.0 1</ambient><diffuse>0.9 0.4 0.0 1</diffuse></material></visual>
        <collision name="c"><geometry><cylinder><radius>0.022</radius><length>0.04</length></cylinder></geometry></collision>
      </link>
      <joint name="joint4" type="revolute"><parent>link3</parent><child>link4</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-3.14</lower><upper>3.14</upper><effort>20</effort></limit><dynamics><damping>0.2</damping></dynamics></axis></joint>

      <link name="link5"><pose relative_to="link4">0 0 0.04 0 0 0</pose>
        <inertial><mass>0.15</mass><inertia><ixx>0.0003</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0003</iyy><iyz>0</iyz><izz>0.0002</izz></inertia></inertial>
        <visual name="joint_cap"><geometry><sphere><radius>0.02</radius></sphere></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
        <visual name="wrist"><pose>0 0 0.025 0 0 0</pose>
          <geometry><cylinder><radius>0.018</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.0 0.35 0.7 1</ambient><diffuse>0.0 0.45 0.85 1</diffuse></material></visual>
        <collision name="c"><pose>0 0 0.025 0 0 0</pose><geometry><cylinder><radius>0.018</radius><length>0.04</length></cylinder></geometry></collision>
      </link>
      <joint name="joint5" type="revolute"><parent>link4</parent><child>link5</child>
        <axis><xyz>0 1 0</xyz><limit><lower>-2.0</lower><upper>2.0</upper><effort>15</effort></limit><dynamics><damping>0.2</damping></dynamics></axis></joint>

      <link name="link6"><pose relative_to="link5">0 0 0.05 0 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia></inertial>
        <visual name="v"><geometry><cylinder><radius>0.018</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.7 0.3 0.0 1</ambient><diffuse>0.9 0.4 0.0 1</diffuse></material></visual>
        <!-- Kol Wrist Kamera -->
        <sensor name="arm_camera" type="camera">
          <pose>0 0 0.01 0 1.57 0</pose>
          <always_on>1</always_on>
          <update_rate>15</update_rate>
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>320</width><height>240</height></image>
            <clip><near>0.01</near><far>5</far></clip>
          </camera>
          <topic>arm/camera</topic>
        </sensor>
        <collision name="c"><geometry><cylinder><radius>0.018</radius><length>0.02</length></cylinder></geometry></collision>
      </link>
      <joint name="joint6" type="revolute"><parent>link5</parent><child>link6</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-3.14</lower><upper>3.14</upper><effort>10</effort></limit><dynamics><damping>0.1</damping></dynamics></axis></joint>

      <link name="gripper_base"><pose relative_to="link6">0 0 0.02 0 0 0</pose>
        <inertial><mass>0.08</mass><inertia><ixx>0.00005</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00005</iyy><iyz>0</iyz><izz>0.00005</izz></inertia></inertial>
        <visual name="v"><geometry><box><size>0.07 0.025 0.015</size></box></geometry>
