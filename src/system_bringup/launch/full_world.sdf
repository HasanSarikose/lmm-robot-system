    <!-- ========== IKA + ROBOT KOL (Birlesik Model) ========== -->
    <model name="ika_with_arm">
      <pose>-2 0 0.05 0 0 0</pose>

      <!-- ===== IKA GOVDE ===== -->
      <link name="base_link">
        <inertial><mass>5.0</mass><inertia><ixx>0.008</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.012</iyy><iyz>0</iyz><izz>0.008</izz></inertia></inertial>
        <visual name="body"><geometry><box><size>0.35 0.22 0.08</size></box></geometry>
          <material><ambient>0.15 0.3 0.15 1</ambient><diffuse>0.2 0.4 0.2 1</diffuse></material></visual>
        <collision name="body"><geometry><box><size>0.35 0.22 0.08</size></box></geometry></collision>
        <visual name="top"><pose>-0.05 0 0.055 0 0 0</pose><geometry><box><size>0.15 0.18 0.03</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <visual name="lidar_visual"><pose>0.12 0 0.07 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.03</length></cylinder></geometry>
          <material><ambient>0 0 0.6 1</ambient><diffuse>0 0 0.8 1</diffuse></material></visual>
        <visual name="camera_visual"><pose>0.16 0 0.02 0 0 0</pose><geometry><box><size>0.02 0.04 0.02</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient></material></visual>
        <!-- Kol montaj platformu -->
        <visual name="arm_platform"><pose>0 0 0.055 0 0 0</pose><geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>

        <!-- IKA Sensorler -->
        <sensor name="ika_camera" type="camera">
          <pose>0.16 0 0.02 0 0 0</pose>
          <always_on>1</always_on>
          <update_rate>15</update_rate>
          <camera>
            <horizontal_fov>1.39</horizontal_fov>
            <image><width>320</width><height>240</height></image>
            <clip><near>0.1</near><far>50</far></clip>
          </camera>
          <topic>ika/camera</topic>
        </sensor>
        <sensor name="ika_lidar" type="gpu_lidar">
          <pose>0.12 0 0.07 0 0 0</pose>
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
            </scan>
            <range><min>0.5</min><max>12.0</max></range>
          </lidar>
          <topic>ika/lidar</topic>
        </sensor>
        <sensor name="ika_imu" type="imu">
          <always_on>1</always_on>
          <update_rate>50</update_rate>
          <topic>ika/imu</topic>
        </sensor>
      </link>

      <!-- ===== IKA TEKERLEKLER ===== -->
      <link name="wheel_fl"><pose relative_to="base_link">0.12 0.12 -0.02 -1.5708 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia></inertial>
        <visual name="v"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <collision name="c"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry>
          <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface></collision>
      </link>
      <joint name="wfl_joint" type="revolute"><parent>base_link</parent><child>wheel_fl</child><axis><xyz>0 0 1</xyz></axis></joint>

      <link name="wheel_fr"><pose relative_to="base_link">0.12 -0.12 -0.02 -1.5708 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia></inertial>
        <visual name="v"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <collision name="c"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry>
          <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface></collision>
      </link>
      <joint name="wfr_joint" type="revolute"><parent>base_link</parent><child>wheel_fr</child><axis><xyz>0 0 1</xyz></axis></joint>

      <link name="wheel_rl"><pose relative_to="base_link">-0.12 0.12 -0.02 -1.5708 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia></inertial>
        <visual name="v"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <collision name="c"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry>
          <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface></collision>
      </link>
      <joint name="wrl_joint" type="revolute"><parent>base_link</parent><child>wheel_rl</child><axis><xyz>0 0 1</xyz></axis></joint>

      <link name="wheel_rr"><pose relative_to="base_link">-0.12 -0.12 -0.02 -1.5708 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia></inertial>
        <visual name="v"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <collision name="c"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry>
          <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface></collision>
      </link>
      <joint name="wrr_joint" type="revolute"><parent>base_link</parent><child>wheel_rr</child><axis><xyz>0 0 1</xyz></axis></joint>

      <!-- ===== ROBOT KOL (IKA uzerinde) ===== -->
      <link name="arm_base"><pose relative_to="base_link">0 0 0.085 0 0 0</pose>
        <inertial><mass>0.4</mass><inertia><ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz></inertia></inertial>
        <visual name="v"><geometry><cylinder><radius>0.03</radius><length>0.03</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
      </link>
      <joint name="arm_base_fix" type="fixed"><parent>base_link</parent><child>arm_base</child></joint>

      <!-- Joint 1: Taban donusu -->
      <link name="arm_link1"><pose relative_to="arm_base">0 0 0.03 0 0 0</pose>
        <inertial><mass>0.3</mass><inertia><ixx>0.0005</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0005</iyy><iyz>0</iyz><izz>0.0005</izz></inertia></inertial>
        <visual name="v"><geometry><cylinder><radius>0.025</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.7 0.3 0.0 1</ambient><diffuse>0.9 0.4 0.0 1</diffuse></material></visual>
      </link>
      <joint name="arm_j1" type="revolute"><parent>arm_base</parent><child>arm_link1</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-3.14</lower><upper>3.14</upper><effort>30</effort></limit><dynamics><damping>2.0</damping></dynamics></axis></joint>

      <!-- Joint 2: Omuz -->
      <link name="arm_link2"><pose relative_to="arm_link1">0 0 0.04 0 0 0</pose>
        <inertial><mass>0.25</mass><inertia><ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.001</iyy><iyz>0</iyz><izz>0.0003</izz></inertia></inertial>
        <visual name="joint_cap"><geometry><sphere><radius>0.02</radius></sphere></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
        <visual name="upper_arm"><pose>0 0 0.07 0 0 0</pose>
          <geometry><box><size>0.025 0.025 0.14</size></box></geometry>
          <material><ambient>0.0 0.35 0.7 1</ambient><diffuse>0.0 0.45 0.85 1</diffuse></material></visual>
      </link>
      <joint name="arm_j2" type="revolute"><parent>arm_link1</parent><child>arm_link2</child>
        <axis><xyz>0 1 0</xyz><limit><lower>-1.57</lower><upper>1.57</upper><effort>30</effort></limit><dynamics><damping>2.0</damping></dynamics></axis></joint>

      <!-- Joint 3: Dirsek -->
      <link name="arm_link3"><pose relative_to="arm_link2">0 0 0.14 0 0 0</pose>
        <inertial><mass>0.2</mass><inertia><ixx>0.0008</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0008</iyy><iyz>0</iyz><izz>0.0002</izz></inertia></inertial>
        <visual name="joint_cap"><geometry><sphere><radius>0.018</radius></sphere></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
        <visual name="forearm"><pose>0 0 0.06 0 0 0</pose>
          <geometry><box><size>0.022 0.022 0.12</size></box></geometry>
          <material><ambient>0.0 0.35 0.7 1</ambient><diffuse>0.0 0.45 0.85 1</diffuse></material></visual>
      </link>
      <joint name="arm_j3" type="revolute"><parent>arm_link2</parent><child>arm_link3</child>
        <axis><xyz>0 1 0</xyz><limit><lower>-2.35</lower><upper>2.35</upper><effort>20</effort></limit><dynamics><damping>1.5</damping></dynamics></axis></joint>

      <!-- Joint 4: Bilek donusu -->
      <link name="arm_link4"><pose relative_to="arm_link3">0 0 0.12 0 0 0</pose>
        <inertial><mass>0.15</mass><inertia><ixx>0.0003</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0003</iyy><iyz>0</iyz><izz>0.0002</izz></inertia></inertial>
        <visual name="v"><geometry><cylinder><radius>0.016</radius><length>0.03</length></cylinder></geometry>
          <material><ambient>0.7 0.3 0.0 1</ambient><diffuse>0.9 0.4 0.0 1</diffuse></material></visual>
      </link>
      <joint name="arm_j4" type="revolute"><parent>arm_link3</parent><child>arm_link4</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-3.14</lower><upper>3.14</upper><effort>15</effort></limit><dynamics><damping>1.0</damping></dynamics></axis></joint>

      <!-- Joint 5: Bilek egim -->
      <link name="arm_link5"><pose relative_to="arm_link4">0 0 0.03 0 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>0.0002</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0002</iyy><iyz>0</iyz><izz>0.0001</izz></inertia></inertial>
        <visual name="joint_cap"><geometry><sphere><radius>0.015</radius></sphere></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
        <visual name="wrist"><pose>0 0 0.02 0 0 0</pose>
          <geometry><cylinder><radius>0.014</radius><length>0.03</length></cylinder></geometry>
          <material><ambient>0.0 0.35 0.7 1</ambient><diffuse>0.0 0.45 0.85 1</diffuse></material></visual>
        <!-- Wrist kamera -->
        <sensor name="arm_camera" type="camera">
          <pose>0 0 0.01 0 1.57 0</pose>
          <always_on>1</always_on>
          <update_rate>15</update_rate>
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>320</width><height>240</height></image>
            <clip><near>0.01</near><far>5</far></clip>
          </camera>
          <topic>arm/camera</topic>
        </sensor>
      </link>
      <joint name="arm_j5" type="revolute"><parent>arm_link4</parent><child>arm_link5</child>
        <axis><xyz>0 1 0</xyz><limit><lower>-2.0</lower><upper>2.0</upper><effort>10</effort></limit><dynamics><damping>1.0</damping></dynamics></axis></joint>

      <!-- Joint 6: Bilek donusu 2 -->
      <link name="arm_link6"><pose relative_to="arm_link5">0 0 0.04 0 0 0</pose>
        <inertial><mass>0.08</mass><inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia></inertial>
        <visual name="v"><geometry><cylinder><radius>0.014</radius><length>0.015</length></cylinder></geometry>
          <material><ambient>0.7 0.3 0.0 1</ambient><diffuse>0.9 0.4 0.0 1</diffuse></material></visual>
      </link>
      <joint name="arm_j6" type="revolute"><parent>arm_link5</parent><child>arm_link6</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-3.14</lower><upper>3.14</upper><effort>8</effort></limit><dynamics><damping>0.8</damping></dynamics></axis></joint>

      <!-- Gripper -->
      <link name="gripper_base"><pose relative_to="arm_link6">0 0 0.015 0 0 0</pose>
        <inertial><mass>0.05</mass><inertia><ixx>0.00003</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00003</iyy><iyz>0</iyz><izz>0.00003</izz></inertia></inertial>
        <visual name="v"><geometry><box><size>0.05 0.02 0.01</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>
      <joint name="gripper_base_joint" type="fixed"><parent>arm_link6</parent><child>gripper_base</child></joint>

      <link name="finger_left"><pose relative_to="gripper_base">-0.018 0 0.015 0 0 0</pose>
        <inertial><mass>0.015</mass><inertia><ixx>0.000003</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000003</iyy><iyz>0</iyz><izz>0.000003</izz></inertia></inertial>
        <visual name="v"><geometry><box><size>0.008 0.015 0.03</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.008 0.015 0.03</size></box></geometry></collision>
      </link>
      <joint name="finger_left_joint" type="prismatic"><parent>gripper_base</parent><child>finger_left</child>
        <axis><xyz>1 0 0</xyz><limit><lower>-0.02</lower><upper>0.0</upper><effort>8</effort></limit><dynamics><damping>0.1</damping></dynamics></axis></joint>

      <link name="finger_right"><pose relative_to="gripper_base">0.018 0 0.015 0 0 0</pose>
        <inertial><mass>0.015</mass><inertia><ixx>0.000003</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000003</iyy><iyz>0</iyz><izz>0.000003</izz></inertia></inertial>
        <visual name="v"><geometry><box><size>0.008 0.015 0.03</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.008 0.015 0.03</size></box></geometry></collision>
      </link>
      <joint name="finger_right_joint" type="prismatic"><parent>gripper_base</parent><child>finger_right</child>
        <axis><xyz>1 0 0</xyz><limit><lower>0.0</lower><upper>0.02</upper><effort>8</effort></limit><dynamics><damping>0.1</damping></dynamics></axis></joint>

      <!-- ===== PLUGINLER ===== -->
      <!-- IKA Hareket -->
      <plugin filename="libignition-gazebo6-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
        <left_joint>wfl_joint</left_joint>
        <left_joint>wrl_joint</left_joint>
        <right_joint>wfr_joint</right_joint>
        <right_joint>wrr_joint</right_joint>
        <wheel_separation>0.24</wheel_separation>
        <wheel_radius>0.04</wheel_radius>
        <topic>ugv_cmd_vel</topic>
        <odom_topic>ugv_odom</odom_topic>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
      <plugin filename="libignition-gazebo6-odometry-publisher-system.so" name="ignition::gazebo::systems::OdometryPublisher">
        <odom_topic>ika/odom</odom_topic>
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>

      <!-- Robot Kol Kontrol -->
      <plugin filename="libignition-gazebo6-joint-position-controller-system.so" name="ignition::gazebo::systems::JointPositionController"><joint_name>arm_j1</joint_name><topic>arm_j1</topic><p_gain>8</p_gain><i_gain>0.05</i_gain><d_gain>4.0</d_gain></plugin>
      <plugin filename="libignition-gazebo6-joint-position-controller-system.so" name="ignition::gazebo::systems::JointPositionController"><joint_name>arm_j2</joint_name><topic>arm_j2</topic><p_gain>8</p_gain><i_gain>0.05</i_gain><d_gain>4.0</d_gain></plugin>
      <plugin filename="libignition-gazebo6-joint-position-controller-system.so" name="ignition::gazebo::systems::JointPositionController"><joint_name>arm_j3</joint_name><topic>arm_j3</topic><p_gain>6</p_gain><i_gain>0.05</i_gain><d_gain>3.0</d_gain></plugin>
      <plugin filename="libignition-gazebo6-joint-position-controller-system.so" name="ignition::gazebo::systems::JointPositionController"><joint_name>arm_j4</joint_name><topic>arm_j4</topic><p_gain>5</p_gain><i_gain>0.05</i_gain><d_gain>2.0</d_gain></plugin>
      <plugin filename="libignition-gazebo6-joint-position-controller-system.so" name="ignition::gazebo::systems::JointPositionController"><joint_name>arm_j5</joint_name><topic>arm_j5</topic><p_gain>4</p_gain><i_gain>0.05</i_gain><d_gain>1.5</d_gain></plugin>
      <plugin filename="libignition-gazebo6-joint-position-controller-system.so" name="ignition::gazebo::systems::JointPositionController"><joint_name>arm_j6</joint_name><topic>arm_j6</topic><p_gain>3</p_gain><i_gain>0.05</i_gain><d_gain>1.0</d_gain></plugin>
      <plugin filename="libignition-gazebo6-joint-position-controller-system.so" name="ignition::gazebo::systems::JointPositionController"><joint_name>finger_left_joint</joint_name><topic>gripper_left</topic><p_gain>20</p_gain><i_gain>0.1</i_gain><d_gain>0.5</d_gain></plugin>
      <plugin filename="libignition-gazebo6-joint-position-controller-system.so" name="ignition::gazebo::systems::JointPositionController"><joint_name>finger_right_joint</joint_name><topic>gripper_right</topic><p_gain>20</p_gain><i_gain>0.1</i_gain><d_gain>0.5</d_gain></plugin>
      <plugin filename="libignition-gazebo6-joint-state-publisher-system.so" name="ignition::gazebo::systems::JointStatePublisher">
        <topic>arm/joint_states</topic>
      </plugin>
    </model>

  </world>
</sdf>