    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive"><left_joint>wl_joint</left_joint><right_joint>wr_joint</right_joint><wheel_separation>0.160</wheel_separation><wheel_radius>0.033</wheel_radius><topic>ugv_cmd_vel</topic><odom_topic>ugv_odom</odom_topic><odom_publish_frequency>30</odom_publish_frequency></plugin>
