<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="turtlebot3">
    <pose>-2 0 0.035 0 0 0</pose>
    <link name="base_link">
      <inertial><mass>1.0</mass><inertia><ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz></inertia></inertial>
      <visual name="body"><geometry><box><size>0.14 0.14 0.07</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
      <collision name="body"><geometry><box><size>0.14 0.14 0.07</size></box></geometry></collision>
      <collision name="caster"><pose>-0.05 0 -0.023 0 0 0</pose><geometry><sphere><radius>0.012</radius></sphere></geometry><surface><friction><ode><mu>0</mu><mu2>0</mu2><slip1>1</slip1><slip2>1</slip2></ode></friction></surface></collision>
    </link>
    <link name="wl"><pose relative_to="base_link">0 0.08 -0.012 -1.5708 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>0.00005</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00005</iyy><iyz>0</iyz><izz>0.00005</izz></inertia></inertial><visual name="v"><geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient></material></visual><collision name="c"><geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision></link>
    <link name="wr"><pose relative_to="base_link">0 -0.08 -0.012 -1.5708 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>0.00005</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00005</iyy><iyz>0</iyz><izz>0.00005</izz></inertia></inertial><visual name="v"><geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient></material></visual><collision name="c"><geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision></link>
